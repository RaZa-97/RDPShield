# Secrets — NEVER commit
config.py
.flask_secret_key

# Database (runtime data)
rdpshield.db
rdpshield.db-wal
rdpshield.db-shm
*.db

# Logs and generated daily reports (contain attacker data)
*.log
logs/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Deployment helpers (server-specific)
run_agent.bat
run_dashboard.bat
panic_unblock.bat

# Dissertation evidence: keep the structure (README + .gitkeep) but DON'T
# commit screenshots / generated tables / raw rows (real attacker IPs, blurred
# secrets). To deliberately include one evidence file:  git add -f <path>
evidence/screenshots/**/*.png
evidence/screenshots/**/*.jpg
evidence/screenshots/**/*.jpeg
evidence/data/*/
evidence/logs/*
!evidence/**/.gitkeep
!evidence/README.md

# Dissertation drafts / Office temp files / DB backups — not part of the tool
*.bak
~$*
